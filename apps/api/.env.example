# Required — copy to .env and fill in real values
DATABASE_URL=postgresql+asyncpg://financialanalyst:changeme@localhost:5432/financialanalyst

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-hex-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Plaid — https://dashboard.plaid.com
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Fernet encryption key for Plaid access tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000
